# Clip Generation Service — Environment Variables

# API
PORT=3000
API_KEY=your-api-key-here

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=clip_generation
PG_USER=clips
PG_PASSWORD=clips_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=brohit-clips
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Webhook (optional, for Бро.Хит callback)
WEBHOOK_URL=

# External APIs (if using managed video generation)
KLING_API_KEY=
MINIMAX_API_KEY=
